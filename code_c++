// Формула информационной энтропии Шеннона (E = L * log2(R))
// E = уровень ентропии (в битах)
// L = длинна пароля
// R = кол-во возможных символов в пуле пароля
// ----------------------------------
// Формула для оценки времени взлома пароля
// N = 2^E
// условный показатель N - 10 миллиардов паролей в секунду (10^10 комбинация per sec)

string timeToCrack (float entropy) {
    double combination = pow (2.0, entropy);
    double speedPerSec = 1e10;
    double seconds = combination / speedPerSec;

    if (seconds < 1) {
       return "Меньше секунды";
    } else if (seconds < 60) {
        return to_string((long long) seconds) + " секунд";
    } else if (seconds < 3600) {
        return to_string((long long) (seconds / 60)) + " минут(ы/a)";
    } else if (seconds < 86400) {
        return  to_string ((long long) (seconds / 3600)) + " час(а/ов)";
    } else if (seconds < 31536000) {
        return to_string((long long) (seconds / 86400)) + " дней";
    } else {
        return to_string((long long) (seconds / 31536000)) + " лет";
    }
}

float calculateSafetyOfPassword (int lengthPass, int poolSize) {
    return lengthPass * log2(poolSize);
}
void levelOfSafety (float &entropy) {
    if (entropy < 40) {
        cout << "Слабый пароль (опасность брутфорса)" << endl;
    } else if (entropy < 60) {
        cout << "Средний пароль" << endl;
    } else if (entropy < 80) {
        cout << "Сильный пароль (устойчив к взлому)" << endl;
    } else {
        cout << "Отличный пароль (максимальная устойчивость)" << endl;
    }
}
